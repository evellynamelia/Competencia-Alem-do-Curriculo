{
  "compilerOptions": {
    "target": "ES2017", "lib": ["dom", "esnext"], "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve",
    "esModuleInterop": true, "isolatedModules": true, "resolveJsonModule": true,
    "skipLibCheck": true, "incremental": true, "allowJs": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
